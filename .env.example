# Copia este archivo como ".env" y llena los valores. El archivo .env NO se sube a Git.
# Cada integrante usa su propia clave; no la compartas por el repositorio.

# Clave del usuario "sa" de SQL Server (la lee docker-compose y restaurar-bd.ps1).
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# Evita estos caracteres para no tener problemas en Docker y PowerShell:  $ " ' # \ `
MSSQL_SA_PASSWORD=

# Conexión de la aplicación (si no pones BD_CLAVE se usa MSSQL_SA_PASSWORD).
BD_SERVIDOR=127.0.0.1,1433
BD_USUARIO=sa
BD_DRIVER=ODBC Driver 18 for SQL Server
